generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  INSTRUCTOR
  MENTOR
  ADMIN
}

enum EvidenceType {
  QUIZ
  PRACTICE
  PROJECT
  LIVE_CLASS
  PORTFOLIO
  INTERVIEW
  ASSESSMENT
  EXTERNAL
}

enum ReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_TEXT
  LONG_TEXT
  NUMERIC
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum ContentAssetType {
  PDF
  VIDEO
  IMAGE
  DOCUMENT
  LINK
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  SUBMIT
  REVIEW
  VERIFY
  LOGIN
  EXPORT
  AI_REQUEST
}

enum AnalyticsEventType {
  PAGE_VIEW
  LESSON_STARTED
  LESSON_COMPLETED
  PRACTICE_STARTED
  PRACTICE_COMPLETED
  ASSESSMENT_STARTED
  ASSESSMENT_SUBMITTED
  PROJECT_SUBMITTED
  PROJECT_REVIEWED
  AI_USED
  RECOMMENDATION_VIEWED
  RECOMMENDATION_ACCEPTED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum PassportVisibility {
  PRIVATE
  SHARED
  PUBLIC
}

enum OpportunityType {
  INTERNSHIP
  JOB
  PROJECT
  SCHOLARSHIP
  COMPETITION
  FREELANCE
}

enum MatchStatus {
  NEW
  SAVED
  APPLIED
  DISMISSED
}

enum PassportVisibility {
  PRIVATE
  SHARED
  PUBLIC
}

enum MasteryLevel {
  UNKNOWN
  BEGINNER
  DEVELOPING
  COMPETENT
  PROFICIENT
  VERIFIED
}

enum CapabilityEvidenceStatus {
  PENDING
  SUPPORTING
  VERIFIED
  EXPIRED
}

enum AIInteractionType {
  CHAT
  EXPLANATION
  RECOMMENDATION
  REMEDIATION
  PROJECT_FEEDBACK
  CONTENT_QA
}

enum LearningSignalType {
  LESSON_PROGRESS
  ASSESSMENT_RESULT
  PROJECT_RESULT
  PRACTICE_RESULT
  SELF_REPORTED
}

enum OpportunityStatus {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  CLOSED
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  passwordHash  String
  name          String
  role          Role        @default(STUDENT)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  profile       StudentProfile?
  enrollments   Enrollment[]
  submissions   Submission[]
  sessions      Session[]
  notifications Notification[]
  auditLogs     AuditLog[]
  lessonProgress LessonProgress[]
  assessmentAttempts AssessmentAttempt[]
  projectSubmissions ProjectSubmission[]
  evidenceOwned Evidence[] @relation("EvidenceOwner")
  projectReviews ProjectReview[] @relation("ProjectReviewer")
  evidenceOwned Evidence[] @relation("EvidenceOwner")
  recommendations Recommendation[]
  aiInteractions AIInteraction[]
  learningSignals LearningSignal[]
  capabilityProfiles CapabilityProfile[]
  masterySnapshots MasterySnapshot[]
  capabilityPassport CapabilityPassport?
  opportunityMatches OpportunityMatch[]
  auditLogs AuditLog[]
  analyticsEvents AnalyticsEvent[]
}

model StudentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerGoal      String?
  learningMode    String   @default("Build-first")
  streak          Int      @default(0)
  readiness       Float    @default(0)
  twinConfidence  Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Course {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  description String
  published   Boolean      @default(false)
  chapters    Chapter[]
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Chapter {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  order       Int
  contentJson Json
  lessons     Lesson[]
  assets      ContentAsset[]
  @@unique([courseId, order])
}

model Lesson {
  id         String   @id @default(cuid())
  chapterId  String
  chapter    Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title       String
  kind        LessonKind
  contentJson Json?
  durationMin Int?
  published   Boolean  @default(false)
  contentUrl  String?
  order       Int
  assets      ContentAsset[]
  progress    LessonProgress[]
  assessments Assessment[]
  projects Project[]
  @@unique([chapterId, order])
}

model ContentAsset {
  id          String            @id @default(cuid())
  courseId    String?
  chapterId   String?
  lessonId    String?
  type        ContentAssetType
  title       String
  storageKey  String?
  url         String?
  mimeType    String?
  sizeBytes   Int?
  metadata    Json?
  createdAt   DateTime          @default(now())
  course      Course?           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapter     Chapter?          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  lesson      Lesson?           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@index([courseId])
  @@index([chapterId])
  @@index([lessonId])
}

model LessonProgress {
  id           String    @id @default(cuid())
  userId       String
  lessonId     String
  completed    Boolean   @default(false)
  percent      Float     @default(0)
  lastPosition Int?
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, lessonId])
  @@index([userId])
}


model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    Float    @default(0)
  lastSeenAt  DateTime @default(now())
  @@unique([userId, courseId])
}



model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  action      AuditAction
  entityType  String
  entityId    String?
  metadata    Json?
  ipHash      String?
  createdAt   DateTime    @default(now())
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model AnalyticsEvent {
  id          String            @id @default(cuid())
  userId      String?
  type        AnalyticsEventType
  path        String?
  entityType  String?
  entityId    String?
  metadata    Json?
  createdAt   DateTime          @default(now())
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model BackgroundJob {
  id          String    @id @default(cuid())
  type        String
  status      JobStatus @default(QUEUED)
  payloadJson Json?
  resultJson  Json?
  error       String?
  attempts    Int       @default(0)
  runAt       DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  @@index([status, runAt])
}

model CapabilityPassport {
  id          String             @id @default(cuid())
  userId      String             @unique
  title       String             @default("Capability Passport")
  summary     String?
  visibility  PassportVisibility @default(PRIVATE)
  slug        String             @unique
  updatedAt   DateTime           @updatedAt
  createdAt   DateTime           @default(now())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       PassportItem[]
}

model PassportItem {
  id            String            @id @default(cuid())
  passportId    String
  capabilityId  String
  label         String?
  displayOrder  Int               @default(0)
  passport      CapabilityPassport @relation(fields: [passportId], references: [id], onDelete: Cascade)
  capability    Capability         @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  @@unique([passportId, capabilityId])
  @@index([passportId, displayOrder])
}

model CareerOpportunity {
  id             String          @id @default(cuid())
  externalKey    String?         @unique
  type           OpportunityType
  title          String
  organization   String?
  description    String?
  location       String?
  url            String?
  requiredJson   Json?
  preferredJson  Json?
  deadline       DateTime?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  matches        OpportunityMatch[]
  @@index([type, active])
}

model OpportunityMatch {
  id             String           @id @default(cuid())
  userId         String
  opportunityId  String
  score          Float            @default(0)
  missingJson    Json?
  matchedJson    Json?
  status         MatchStatus      @default(NEW)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity    CareerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@unique([userId, opportunityId])
  @@index([userId, score])
}

model Capability {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String
  evidence    Evidence[]
  graphEdges  LearningEdge[] @relation("CapabilityEdges")
}



model Submission {
  id         String           @id @default(cuid())
  userId     String
  evidenceId String?
  title      String
  status     SubmissionStatus @default(DRAFT)
  score      Float?
  feedback   String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence   Evidence?        @relation(fields: [evidenceId], references: [id])
}



model Project {
  id             String        @id @default(cuid())
  courseId       String?
  title          String
  description    String?
  instructions   String?
  status         ProjectStatus @default(DRAFT)
  dueAt          DateTime?
  maxScore       Float         @default(100)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  course         Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  submissions    ProjectSubmission[]
  @@index([courseId])
}

model ProjectSubmission {
  id             String       @id @default(cuid())
  projectId      String
  userId         String
  status         ProjectStatus @default(SUBMITTED)
  title          String?
  description    String?
  submissionUrl  String?
  repositoryUrl  String?
  demoUrl        String?
  filesJson      Json?
  submittedAt    DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews        ProjectReview[]
  @@index([projectId, userId])
}

model ProjectReview {
  id            String       @id @default(cuid())
  submissionId  String
  reviewerId    String
  status        ReviewStatus @default(PENDING)
  score         Float?
  feedback      String?
  rubricJson    Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  submission    ProjectSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer      User         @relation("ProjectReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  @@index([submissionId])
}

model Evidence {
  id             String        @id @default(cuid())
  userId         String
  submissionId   String?
  type           EvidenceType
  title          String
  description    String?
  score          Float?
  verified       Boolean       @default(false)
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation("EvidenceOwner", fields: [userId], references: [id], onDelete: Cascade)
  submission     ProjectSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  capabilityLinks CapabilityEvidence[]
  @@index([userId, type])
  @@index([submissionId])
}

model Assessment {
  id String @id @default(cuid())
  lessonId String?
  title String
  instructions String?
  status AssessmentStatus @default(DRAFT)
  passingScore Float @default(70)
  maxAttempts Int @default(3)
  timeLimitMin Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts AssessmentAttempt[]
}

model Question {
  id String @id @default(cuid())
  assessmentId String
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  type QuestionType
  prompt String
  optionsJson Json?
  answerJson Json?
  explanation String?
  points Float @default(1)
  order Int
  answers AttemptAnswer[]
  @@unique([assessmentId, order])
}

model AssessmentAttempt {
  id String @id @default(cuid())
  assessmentId String
  userId String
  status AttemptStatus @default(IN_PROGRESS)
  score Float?
  passed Boolean?
  startedAt DateTime @default(now())
  submittedAt DateTime?
  gradedAt DateTime?
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers AttemptAnswer[]
  @@index([userId, assessmentId])
}

model AttemptAnswer {
  id String @id @default(cuid())
  attemptId String
  questionId String
  responseJson Json
  isCorrect Boolean?
  pointsAwarded Float?
  feedback String?
  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  @@unique([attemptId, questionId])
}

model LearningEdge {
  id             String      @id @default(cuid())
  fromType       String
  fromId         String
  toType         String
  toId           String
  relation       String
  confidence     Float       @default(1)
  createdAt      DateTime    @default(now())
  capabilityId   String?
  capability     Capability? @relation("CapabilityEdges", fields: [capabilityId], references: [id])
  @@index([fromType, fromId])
  @@index([toType, toId])
}

model Recommendation {
  id          String   @id @default(cuid())
  userId      String
  actionType  String
  actionRef   String
  reasonJson  Json
  score       Float
  accepted    Boolean?
  createdAt   DateTime @default(now())
}



model Capability {
  id             String          @id @default(cuid())
  key            String          @unique
  name           String
  description    String?
  category       String?
  levelOrder     Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  requirements   CapabilityRequirement[]
  profiles       CapabilityProfile[]
  passportItems  PassportItem[]
}

model CapabilityRequirement {
  id             String      @id @default(cuid())
  capabilityId   String
  requirementKey String
  description    String?
  weight         Float       @default(1)
  threshold      Float       @default(0.7)
  capability     Capability  @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  @@unique([capabilityId, requirementKey])
}

model CapabilityProfile {
  id             String             @id @default(cuid())
  userId         String
  capabilityId   String
  mastery        Float              @default(0)
  level          MasteryLevel       @default(UNKNOWN)
  verified       Boolean            @default(false)
  confidence     Float              @default(0)
  lastAssessedAt DateTime?
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  capability     Capability         @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  evidenceLinks  CapabilityEvidence[]
  @@unique([userId, capabilityId])
  @@index([userId, mastery])
}

model CapabilityEvidence {
  id            String                   @id @default(cuid())
  capabilityId  String
  evidenceId    String
  status        CapabilityEvidenceStatus  @default(PENDING)
  contribution  Float                    @default(0)
  createdAt     DateTime                 @default(now())
  capability    Capability               @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  evidence      Evidence                 @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  @@unique([capabilityId, evidenceId])
}

model MasterySnapshot {
  id             String    @id @default(cuid())
  userId         String
  masteryJson    Json
  reason         String?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model AIInteraction {
  id           String            @id @default(cuid())
  userId       String
  type         AIInteractionType
  requestJson  Json
  responseJson Json
  provider     String
  model        String?
  createdAt    DateTime          @default(now())
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model LearningSignal {
  id          String             @id @default(cuid())
  userId      String
  type        LearningSignalType
  sourceId    String?
  topic       String?
  value       Float?
  metadata    Json?
  createdAt   DateTime           @default(now())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, type, createdAt])
}

model Opportunity {
  id          String             @id @default(cuid())
  title       String
  company     String
  location    String?
  url         String?
  skillsJson  Json
  status      OpportunityStatus  @default(SAVED)
  createdAt   DateTime            @default(now())
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  hash      String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([entity, entityId])
}
